# Iryax AI Multi-Agent Platform â€” Production Environment Configuration
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Copy this file to .env on the production server.
# NEVER commit the real .env file with secrets into version control.

# Core LLM Inference (Groq Cloud API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# JWT Authentication & Admin Security
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_key_min_32_chars
JWT_ISSUER=iryax-platform
JWT_AUDIENCE=iryax-admins
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Production CORS Allowed Origins (Comma-separated exact origins)
CORS_ALLOWED_ORIGINS=https://app.iryax.com,https://iryax.com

# Server & Network Settings
HOST=0.0.0.0
PORT=8000

# Support & Contact Information
CONTACT_EMAIL=info@ingrainsystem.com
CONTACT_PHONE=+91-9010481048

